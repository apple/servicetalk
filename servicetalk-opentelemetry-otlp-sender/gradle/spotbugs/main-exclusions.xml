<FindBugsFilter>
  <!-- Response body arrays are freshly produced per response (copied out of the buffer, or an unpooled
       exactly-sized array from the byte[] deserializer) and handed straight to the OTel SDK, which reads
       but never mutates or retains them. Returning them directly avoids a redundant copy on every export. -->
  <Match>
    <Class name="io.servicetalk.opentelemetry.otlp.ServiceTalkGrpcSender$GrpcResponseImpl"/>
    <Method name="getResponseMessage"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <Match>
    <Class name="io.servicetalk.opentelemetry.otlp.ServiceTalkHttpSender$HttpResponseImpl"/>
    <Method name="getResponseBody"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
</FindBugsFilter>
